{
  "manifest_version": 3,
  "name": "Insta Lucky Winner Picker",
  "version": "1.2.0",
  "description": "Reads all comments from any Instagram post or reel and picks a fair lucky giveaway winner with filters.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "unlimitedStorage",
    "cookies"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "http://localhost:3001/*",
        "http://127.0.0.1:3001/*",
        "http://localhost:3002/*",
        "http://127.0.0.1:3002/*"
      ],
      "js": ["src/auto-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*",
      "http://localhost:3001/*",
      "http://127.0.0.1:3001/*",
      "http://localhost:3002/*",
      "http://127.0.0.1:3002/*"
    ]
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Insta Lucky Winner Picker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
